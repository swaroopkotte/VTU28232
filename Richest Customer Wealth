class Solution {
    public int maximumWealth(int[][] accounts) {
        int maxWealth = 0;
        for (int i = 0; i < accounts.length; i++) {
            int sum = 0;
            for (int j = 0; j < accounts[i].length; j++) {
                sum += accounts[i][j];  // add up this customer's wealth
            }
            maxWealth = Math.max(maxWealth, sum);  // track the richest
        }
        return maxWealth;
    }
}
