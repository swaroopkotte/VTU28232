import java.util.Arrays;
import java.util.List;
public class Map{
    public static void main(String[] args) {
        List<Integer> salaries = Arrays.asList(10000, 20000, 30000, 40000, 50000);
        salaries.stream()
                .map(salary ->salary+salary*0.10)   
                .forEach(System.out::println);
    }
}
